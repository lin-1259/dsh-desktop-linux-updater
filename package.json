{
  "name": "dsh-desktop-linux-updater",
  "version": "0.1.0",
  "description": "One-click update for self-built Linux dsh-desktop: checks the fork's GitHub releases, downloads the deb, swaps the app dir and restarts. 桌面端 Linux 自建版一键更新。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-runtime"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "dsh-desktop", "linux", "updater"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lin-1259/dsh-desktop-linux-updater.git"
  }
}
